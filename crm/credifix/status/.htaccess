# .htaccess - Apache Configuration for credifix.in/status

# Enable Rewrite Engine
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /status/

    # Ensure index.php handles requests
    DirectoryIndex index.php index.html
</IfModule>

# Disable Directory Browsing
Options -Indexes

# Protect SQLite Database & Log files from direct public download
<FilesMatch "\.(sqlite|sqlite3|db|log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Enable UTF-8 Encoding
AddDefaultCharset UTF-8
